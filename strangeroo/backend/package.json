{
  "name": "@strangeroo/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Strangeroo backend — Fastify + Socket.IO",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.12.5",
    "ioredis": "^5.3.2",
    "pg": "^8.11.5",
    "razorpay": "^2.9.2",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
