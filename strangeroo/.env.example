# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Data
DATABASE_URL=postgres://strangeroo:strangeroo@localhost:5432/strangeroo
REDIS_URL=redis://localhost:6379

# Auth / sessions
SESSION_TOKEN_SECRET=change_me_long_random_string_at_least_32_chars
JWT_SECRET=change_me_another_long_random_string_at_least_32_chars

# WebRTC
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.yourdomain.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=change_me_coturn_static_auth_secret

# Razorpay (use TEST keys in dev — never commit live keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Optional: Email (for OTP auth in Phase 7)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@strangeroo.app

# Optional: Google OAuth (for Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
